{
  "name": "unpin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Strip identifying metadata from photos and documents, entirely in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "fixtures": "python3 scripts/make-fixtures.py",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "exifr": "^7.1.3",
    "jszip": "^3.10.2",
    "libheif-js": "^1.19.8",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "1.56.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
